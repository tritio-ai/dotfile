;;; .emacs.local --- Machine-local Emacs config -*- lexical-binding: t -*-

;;; Commentary:
;; This file is copied to ~/.emacs.local by emacs/install.sh when it does not
;; exist. Keep private paths, machine-specific UI, secrets, and local package
;; settings here.

;;; Code:

;; Example: machine-specific font size.
;; (set-face-attribute 'default nil :height 130)

;; Example: private Org locations.
;; (setq org-directory "~/org")
;; (setq org-agenda-files (list org-directory))

;; Example: machine-specific PATH entries for subprocesses.
;; (let ((local-bin (expand-file-name "~/.local/bin")))
;;   (add-to-list 'exec-path local-bin)
;;   (setenv "PATH" (concat local-bin path-separator (getenv "PATH"))))

;; Example: private key bindings.
;; (global-set-key (kbd "C-c o") #'find-file)

;; Optional private vault overlay. Set DOTFILE_VAULT only on machines that
;; should execute it; an absent or unreadable checkout is ignored safely.
(let ((vault-root (getenv "DOTFILE_VAULT")))
  (when vault-root
    (let ((vault-init (expand-file-name "init.el" vault-root)))
      (when (file-readable-p vault-init)
        (load vault-init nil 'nomessage)))))

(provide 'dotfile-emacs-local)
;;; .emacs.local ends here
